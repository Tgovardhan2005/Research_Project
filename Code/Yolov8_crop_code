    # Iterate through the results to get bounding boxes and crop them
    for r_idx, r in enumerate(results):
        boxes = r.boxes  # Bounding boxes object
        names = r.names # Class names

        for box_idx, box in enumerate(boxes):
            # Get bounding box coordinates in xyxy format (x1, y1, x2, y2)
